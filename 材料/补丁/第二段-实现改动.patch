+    def _format_report(self, items):
+        names = {"空腹血糖": "空腹时血液里的葡萄糖水平",
+                 "总胆固醇": "血液里的胆固醇总量"}
+        lines = []
+        for item in items:
+            name = item["name"]
+            description = names.get(name)
+            label = f"{name}（{description}）" if description else name
+            line = f"{label}：测量值为 {item.get('value') or '未识别'}"
+            if item.get("unit"):
+                line += f" {item['unit']}"
+            if item.get("ref"):
+                line += f"，本报告参考范围为 {item['ref']}"
+            lines.append(line + "。")
+        return "\n".join(lines)
+
